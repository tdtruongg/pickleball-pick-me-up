{
  "name": "pickleball-3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "build:render": "npm ci --prefix client --include=dev && npm run build --prefix client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p shared --noEmit && tsc -p client --noEmit",
    "setup": "npm install && npm install --prefix client"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vitest": "~2.1.8"
  }
}
